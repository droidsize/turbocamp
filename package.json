{
  "name": "turbocamp",
  "version": "1.0.0",
  "bin": {
    "turbocamp": "dist/index.js"
  },
  "files": ["dist/index.js"],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "email:dev": "email dev --port 3003 --dir packages/email/templates",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "lint": "ultracite lint",
    "format": "ultracite format",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "npx npm-check-updates --deep -u -x react-day-picker",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/base",
    "migrate": "cd apps/api && pnpm prisma format && pnpm prisma generate && pnpm prisma db push",
    "clean": "git clean -xdf node_modules"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.0",
    "@biomejs/biome": "2.4.6",
    "@tooling/typescript-config": "workspace:*",
    "@turbo/gen": "^2.8.13",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "turbo": "^2.8.13",
    "typescript": "^5.9.3",
    "ultracite": "^7.2.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0"
  },
  "type": "module"
}
